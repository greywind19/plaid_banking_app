# Plaid sandbox credentials — get these from https://dashboard.plaid.com (free)
# Never commit the real .env file.
PLAID_CLIENT_ID=your_client_id_here
PLAID_SECRET=your_sandbox_secret_here
PLAID_ENV=sandbox

# REST API port (the React UI calls this)
PORT=8787

# Sandbox institution used to bootstrap demo data.
# ins_109508 = Plaid's standard sandbox test institution.
SANDBOX_INSTITUTION_ID=ins_109508

# ---------------------------------------------------------------------------
# LLM agent — which brain powers the copilot.
# LLM_PROVIDER=foundry (default, Azure AI Foundry / Azure OpenAI) or openai
# ---------------------------------------------------------------------------
LLM_PROVIDER=foundry

# Agent backend: local (in-process tool-loop, app/agent.py) or foundry (Foundry
# Agent Service — a managed hosted agent with server-side Threads + Runs). Same
# tools, same answers; flip to compare the two architectures.
AGENT_BACKEND=local
# Foundry project endpoint (only used when AGENT_BACKEND=foundry).
# Portal: your project > Overview > "endpoint" (ends with /api/projects/<name>).
AZURE_AI_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project

# Azure AI Foundry / Azure OpenAI (used when LLM_PROVIDER=foundry or azure).
# Get these from your model deployment page in https://ai.azure.com
# Endpoint: the account endpoint, e.g. https://<resource>.openai.azure.com/
#   or (newer Foundry AIServices) https://<resource>.cognitiveservices.azure.com/
AZURE_OPENAI_ENDPOINT=https://your-project.cognitiveservices.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2025-04-01-preview
#
# --- Auth: pick ONE ---
# (A) API key — set this if your resource allows key auth:
# AZURE_OPENAI_API_KEY=your_foundry_key_here
#
# (B) Keyless (recommended; required if local/key auth is disabled by policy):
#     leave AZURE_OPENAI_API_KEY unset and run `az login`. Your identity needs
#     the "Cognitive Services OpenAI User" role on the resource. If the resource
#     is in a different tenant than your default az sub (e.g. MCAP/sandbox),
#     pin it here so the CLI grabs a token from the right directory:
# AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
#
# (C) Service principal (for CONTAINERS / CI — no `az login` inside a container):
#     create an app registration IN THE SAME TENANT as the resource, give its
#     service principal the same roles, then set all three below. The code uses
#     ClientSecretCredential when these are present. In Azure (ACA/AKS) delete
#     all three and a Managed Identity is used automatically (zero code change).
# AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_SECRET=your-client-secret-value

# Plain OpenAI fallback (used when LLM_PROVIDER=openai).
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o
