# Copy this file to `secrets.auto.tfvars` (gitignored) and fill in real values.
# Terraform auto-loads any *.auto.tfvars file, so these get picked up on plan/apply.
#
#   cp secrets.auto.tfvars.example secrets.auto.tfvars
#   # then edit secrets.auto.tfvars

# Postgres admin password — >= 8 chars, mix of upper/lower/digit/special.
postgres_admin_password = "CHANGE_ME_Str0ng!Pass"

# Plaid sandbox credentials (same ones from your server .env).
plaid_client_id = "your_plaid_client_id"
plaid_secret    = "your_plaid_sandbox_secret"

# Optional: your public IP to allow direct psql access for debugging.
# admin_ip_address = "203.0.113.7"
