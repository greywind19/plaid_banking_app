{
  "name": "banking-copilot-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plaid-backed core service exposed as both a REST API (for the UI) and an MCP server (for the future agent).",
  "scripts": {
    "dev:api": "tsx watch src/http-server.ts",
    "start:api": "tsx src/http-server.ts",
    "start:mcp": "tsx src/mcp-server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "plaid": "^29.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
